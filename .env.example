# PostgreSQL (local: docker compose up -d)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Docker publishes Postgres on host port 15432 by default (see docker-compose.yml). If that port is busy,
# add a root `.env` (same folder as docker-compose.yml) with e.g. POSTGRES_HOST_PORT=15433 and match the
# port here in DATABASE_URL. Compose reads `.env` for POSTGRES_HOST_PORT; Next.js reads `.env.local`.
# User/password in Docker: postgres / postgres.
# If sign-up returns 500 and logs show "password authentication failed for user postgres" (28P01),
# fix DATABASE_URL in .env.local — wrong DB password, not your app login password.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:15432/languini

# Better Auth — use a long random string in production
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-in-production
BETTER_AUTH_URL=http://localhost:3000

# Optional: used when resolving auth client base URL during SSR
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard — comma-separated list of emails that can access /admin
# ADMIN_EMAILS=you@example.com,another@example.com

# Playwright: skip auth middleware so lesson E2E can run without a logged-in user
# E2E_SKIP_AUTH=1

# Playwright: run against a real DB + full auth (docker compose + db:migrate first)
# E2E_WITH_DB=1
